<div class="container mt-4 swipes-page" data-controller="swipe">
  <h1>Find Your Vibe</h1>

  <% if @show_card_fallback_notice %>
    <div class="alert alert-warning" role="status">
      No photo cards match both this event's budget and group size.
      We're showing other photo cards so your team can still share its preferences.
      Some cards may fall outside your event limits.
    </div>
  <% end %>

  <% if @current_card.present? %>
    <p><%= @completed_count %> / <%= @total_cards %> completed</p>

    <div class="progress mb-4">
      <div
        class="progress-bar"
        style="width: <%= @completed_count.to_f / @total_cards * 100 %>%">
      </div>
    </div>

    <div class="swipe-card-stack">
      <div class="swipe-card-shadow swipe-card-shadow--back" aria-hidden="true"></div>
      <div class="swipe-card-shadow swipe-card-shadow--front" aria-hidden="true"></div>

      <article
        class="card p-4 swipe-card"
        data-swipe-target="card"
        data-action="
          pointerdown->swipe#start
          pointermove->swipe#move
          pointerup->swipe#finish
          pointercancel->swipe#cancel">

        <div
          class="swipe-stamp swipe-stamp--like"
          data-swipe-target="likeStamp"
          aria-hidden="true">
          LIKE
        </div>

        <div
          class="swipe-stamp swipe-stamp--nope"
          data-swipe-target="dislikeStamp"
          aria-hidden="true">
          NOPE
        </div>

        <% if @current_card.vibe_card.image_url.present? %>
          <%= image_tag @current_card.vibe_card.image_url,
                        class: "img-fluid rounded mb-3",
                        alt: @current_card.vibe_card.title %>
        <% end %>

        <h2><%= @current_card.vibe_card.title %></h2>
        <p><%= @current_card.vibe_card.description %></p>
      </article>
    </div>

    <div class="d-flex gap-3 swipe-buttons">
      <%= button_to "Dislike",
                    participant_swipes_path(@participant.token),
                    method: :post,
                    params: {
                      nomikai_vibe_card_id: @current_card.id,
                      liked: false
                    },
                    class: "btn btn-danger",
                    data: { swipe_target: "dislikeButton" } %>

      <%= button_to "Like",
                    participant_swipes_path(@participant.token),
                    method: :post,
                    params: {
                      nomikai_vibe_card_id: @current_card.id,
                      liked: true
                    },
                    class: "btn btn-success",
                    data: { swipe_target: "likeButton" } %>
    </div>
  <% else %>
    <section class="swipe-complete-card" role="status">
      <span class="swipe-complete-icon" aria-hidden="true">✓</span>
      <p class="swipe-complete-label">PREFERENCES COMPLETE</p>

      <h2>All done!</h2>
      <p>Your preferences have been saved. The organizer can now use them to find a restaurant for your team.</p>

      <%= link_to "Back to your event",
                  participant_path(@participant.token),
                  class: "swipe-back-button" %>
    </section>
  <% end %>
</div>
