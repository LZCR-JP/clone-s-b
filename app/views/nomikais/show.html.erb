<div class="container py-5">
  <div class="nomikai-show">

    <%= link_to "← My Dining Events", nomikais_path,
                class: "back-link" %>

    <!-- Event header -->
    <div class="event-header mt-4">
      <div>
        <span class="event-label">YOUR DINING EVENT</span>
        <h1><%= @nomikai.name %></h1>
        <p>Bring your team together for a great dining experience.</p>
      </div>

      <span class="event-status <%= @nomikai.status %>">
        <%= @nomikai.status.capitalize %>
      </span>
    </div>

    <!-- Event details -->
    <div class="event-details">
      <div class="detail-card">
        <span>LOCATION</span>
        <strong><%= @nomikai.area %></strong>
      </div>

      <div class="detail-card">
        <span>DATE & TIME</span>
        <strong><%= @nomikai.event_date.strftime("%b %d, %Y · %H:%M") %></strong>
      </div>

      <div class="detail-card">
        <span>GROUP SIZE</span>
        <strong><%= @nomikai.group_size %> people</strong>
      </div>

      <div class="detail-card">
        <span>BUDGET PER PERSON</span>
        <strong>
          <%= @nomikai.budget_per_person.present? ? "¥#{number_with_delimiter(@nomikai.budget_per_person)}" : "Not specified" %>
        </strong>
      </div>
    </div>

    <% if @selected_candidate.present? %>
        <% place_id = @selected_candidate.venue.google_place_id %>
        <% maps_url = "https://www.google.com/maps/search/?api=1&query=restaurant&query_place_id=#{ERB::Util.url_encode(place_id)}" %>

        <div class="show-section selected-restaurant">
          <span class="event-label">RESTAURANT SELECTED</span>
          <h2>Your choice is saved</h2>
          <p>Open the selected place in Google Maps to share it with your group.</p>

          <%= link_to "View selected restaurant on Google Maps",
                      maps_url,
                      class: "selected-restaurant-link",
                      target: "_blank",
                      rel: "noopener noreferrer" %>
        </div>
      <% end %>

    <!-- AI Preference Summary -->
    <% summary = @preference_summary %>
    <% restrictions = summary[:dietary_restrictions] %>
    <% budgets = summary[:participant_budget_maxima] %>
    <% liked_vibes = summary[:liked_vibes] %>
    <% disliked_vibes = summary[:disliked_vibes] %>

    <div class="show-section">
      <h2>Restaurant match preferences</h2>

      <p><strong>Area:</strong> <%= summary[:area] %></p>
      <p>
        <strong>Event budget per person:</strong>
        <%= summary[:event_budget_per_person].present? ? number_to_currency(summary[:event_budget_per_person], unit: "¥", precision: 0) : "Not specified" %>
      </p>
      <p><strong>Group size:</strong> <%= summary[:group_size] %></p>
      <p>
        <strong>Responses completed:</strong>
        <%= summary[:participants_completed] %> of <%= summary[:participants_joined] %> joined
      </p>
      <p>
        <strong>Participant budget limits:</strong>
        <%= budgets.any? ? budgets.map { |amount| number_to_currency(amount, unit: "¥", precision: 0) }.join(", ") : "Not specified" %>
      </p>
      <p>
        <strong>Dietary restrictions:</strong>
        <%= restrictions.any? ? restrictions.map { |name, count| "#{name} (#{count})" }.join(", ") : "None reported" %>
      </p>
      <p><strong>Non-drinkers:</strong> <%= summary[:non_drinkers] %></p>
      <p>
        <strong>Liked vibes:</strong>
        <%= liked_vibes.any? ? liked_vibes.map { |title, count| "#{title} (#{count})" }.join(", ") : "No likes yet" %>
      </p>
      <p>
        <strong>Disliked vibes:</strong>
        <%= disliked_vibes.any? ? disliked_vibes.map { |title, count| "#{title} (#{count})" }.join(", ") : "No dislikes yet" %>
      </p>
    </div>

    <!-- Invitation link -->
    <div class="show-section invite-section">
      <h2>Invite your team</h2>
      <p>Share this link with your teammates so they can join and swipe.</p>

      <div data-controller="clipboard" class="invite-link">
        <input
          type="text"
          class="form-control"
          value="<%= join_url(@nomikai.share_token) %>"
          readonly
          data-clipboard-target="source">

        <button
          type="button"
          class="btn-copy"
          data-action="click->clipboard#copy">
          Copy link
        </button>

        <small data-clipboard-target="message"></small>
      </div>
    </div>

    <!-- Participants -->
    <% completed_count = @participants.where.not(completed_at: nil).count %>
    <% progress = (completed_count.to_f / @nomikai.group_size * 100).round %>

    <div class="show-section participants-section">
      <div class="section-heading">
        <div>
          <h2>Team participation</h2>
          <p>See who's completed their restaurant preferences.</p>
        </div>

        <strong><%= completed_count %> / <%= @nomikai.group_size %></strong>
      </div>

      <div class="progress-track">
        <div class="progress-fill" style="width: <%= progress %>%"></div>
      </div>

      <% if @participants.any? %>
        <div class="participant-list">
          <% @participants.each do |participant| %>
            <div class="participant-row">
              <div class="participant-avatar">
                <%= participant.nickname.first.upcase %>
              </div>

              <strong><%= participant.nickname %></strong>

              <% if participant.completed_at.present? %>
                <span class="participant-status completed">Completed</span>
              <% else %>
                <span class="participant-status pending">Pending</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-participants">
          <p>No participants yet.</p>
          <span>Share your invitation link to get your team started!</span>
        </div>
      <% end %>
    </div>

    <!-- Event actions -->
    <div class="event-actions">
      <% if @nomikai.status == "open" %>
        <%= button_to "Close Event",
                      close_nomikai_path(@nomikai),
                      method: :patch,
                      class: "btn-close-event",
                      form: { data: { turbo_confirm: "Are you sure you want to close this event?" } } %>
      <% end %>

      <%= button_to "Delete Event",
                    nomikai_path(@nomikai),
                    method: :delete,
                    class: "btn-delete-event",
                    form: { data: { turbo_confirm: "Are you sure you want to delete this event?" } } %>

      <%= form_with url: recommendations_nomikai_path(@nomikai),
                    method: :post,
                    data: { turbo: false } do %>
        <%= button_tag "Find restaurant candidates",
                      class: "btn-find-candidates" %>
      <% end %>
    </div>

  </div>
</div>
