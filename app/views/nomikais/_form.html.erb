
<div class="create-event-page">
  <div class="create-event-container">

    <%# BACK NAVIGATION %>
    <%= link_to nomikais_path, class: "event-back-link" do %>
      ← Back to My Dining Events
    <% end %>

    <%# PAGE HEADER %>
    <div class="create-event-header">
      <span class="event-eyebrow">SWIPE & BITE · TOKYO</span>

      <% if @nomikai.persisted? %>
        <h1>Edit your <span>team dinner.</span></h1>
        <p>Update your gathering details below.</p>
      <% else %>
        <h1>Setup your next <span>team dinner.</span></h1>
        <p>
          Set up your dining event and invite your colleagues
          to discover a restaurant everyone will enjoy.
        </p>
      <% end %>
    </div>

    <%# FORM CARD %>
    <div class="create-event-card">

      <div class="form-card-header">
        <div>
          <h2>Event Details</h2>
          <p>Tell us a little about your gathering.</p>
        </div>
        <span class="form-header-icon">🍽️</span>
      </div>

      <% if @nomikai.errors.any? %>
        <div class="event-form-errors">
          <strong>Please check the following:</strong>
          <ul>
            <% @nomikai.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= simple_form_for @nomikai, html: { class: "event-form" } do |f| %>

        <%# EVENT NAME %>
        <%= f.input :name,
              label: "Event name",
              placeholder: "e.g. Friday Team Dinner",
              hint: "Give your dining event a name.",
              required: true,
              wrapper_html: { class: "event-form-group" },
              input_html: { class: "event-input" } %>

        <%# LOCATION %>
        <div class="event-form-group">
          <%= f.label :area, "Preferred area in Tokyo" %>

          <div class="event-input-wrapper">
            <span class="event-input-icon">📍</span>
            <%= f.input_field :area,
                  class: "event-input with-icon",
                  placeholder: "e.g. Shibuya, Shinjuku, Marunouchi",
                  required: true %>
          </div>

          <%= f.error :area %>
          <small>Where would your team like to eat?</small>
        </div>

        <%# DATE AND TIME %>
        <%= f.input :event_date,
              as: :datetime,
              html5: true,
              label: "Event date and time",
              hint: "When are you planning to meet?",
              required: true,
              wrapper_html: { class: "event-form-group" },
              input_html: {
                class: "event-input",
                min: Time.current.strftime("%Y-%m-%dT%H:%M")
              } %>

        <%# GROUP SIZE %>
        <div data-controller="range-output">
          <%= f.input :group_size,
                as: :range,
                label: "Expected group size",
                hint: "Including the host.",
                wrapper_html: { class: "event-form-group" },
                input_html: {
                  class: "event-input",
                  min: 2,
                  max: 50,
                  step: 1,
                  data: {
                    range_output_target: "input",
                    action: "input->range-output#update"
                  }
                } %>

          <output data-range-output-target="output"></output>
        </div>

        <%# BUDGET %>
        <div data-controller="range-output"
             data-range-output-prefix-value="¥">

          <%= f.input :budget_per_person,
                as: :range,
                label: "Budget per person",
                required: false,
                wrapper_html: { class: "event-form-group" },
                input_html: {
                  class: "event-input",
                  min: 2000,
                  max: 15000,
                  step: 500,
                  data: {
                    range_output_target: "input",
                    action: "input->range-output#update"
                  }
                } %>

          <output data-range-output-target="output"></output>

          <label>
            <%= check_box_tag :flexible, "1",
                  @nomikai.persisted? && @nomikai.budget_per_person.nil?,
                  data: {
                    range_output_target: "toggle",
                    action: "change->range-output#update"
                  } %>
            I'm flexible
          </label>
        </div>

        <%# INFORMATION BOX %>
        <div class="event-info-box">
          <span>💡</span>
          <p>
            Once your event is created, you can share an invitation
            link with colleagues. They can join and swipe through
            restaurant preferences.
          </p>
        </div>

        <%# SUBMIT %>
        <div class="event-form-actions">
          <%= f.submit(
                @nomikai.persisted? ? "Update Dining Event →" : "Create Dining Event →",
                class: "event-submit-btn"
              ) %>

          <%= link_to "Cancel",
                @nomikai.persisted? ? nomikai_path(@nomikai) : nomikais_path,
                class: "event-cancel-btn" %>
        </div>

      <% end %>
    </div>

    <p class="event-footer-note">
      Good food. Better teams. Better together.
    </p>

  </div>
</div>
