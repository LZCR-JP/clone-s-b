<section class="recommendation-card">
  <div class="recommendation-details">
    <h2>✨ Why these restaurants?</h2>

    <p>
      Search based on the responses received so far.
    </p>

    <p>
      <strong>Area:</strong>
      <%= summary[:area].to_s.titleize %>
    </p>

    <p>
      <strong>Group size:</strong>
      <%= summary[:group_size] %> people
    </p>

    <% if summary[:effective_budget_per_person].present? %>
      <p>
        <strong>Budget:</strong>
        ¥<%= number_with_delimiter(
          summary[:effective_budget_per_person]
        ) %> per person
      </p>
    <% end %>

    <p>
      <strong>Responses:</strong>
      <%= summary[:participants_completed] %>
      completed
    </p>

    <p>
      <strong>Non-drinkers:</strong>
      <%= summary[:non_drinkers] %>
    </p>

    <% if summary[:dietary_restrictions].any? %>
      <p>
        <strong>Dietary requirements:</strong>

        <%= summary[:dietary_restrictions]
              .map { |name, count| "#{name.to_s.titleize} (#{count})" }
              .join(", ") %>
      </p>
    <% end %>

    <% cuisines = summary[:cuisine_preferences]
         .select { |_, data| data[:like_rate] >= 60 }
         .sort_by { |_, data| [-data[:like_rate], -data[:participants]] }
         .first(3) %>

    <% if cuisines.any? %>
      <h3>Popular cuisines in current responses</h3>

      <% cuisines.each do |name, data| %>
        <p>
          <%= name.to_s.titleize %> —
          <%= data[:like_rate] %>% positive
          (<%= pluralize(data[:participants], "voter") %>)
        </p>
      <% end %>
    <% end %>

    <% vibes = summary[:vibe_evidence]
         .select do |_, data|
           data[:liked_average].present? &&
             data[:disliked_average].present? &&
             data[:likes] >= 2 &&
             data[:dislikes] >= 2 &&
             data[:liked_average] > data[:disliked_average]
         end
         .sort_by do |_, data|
           -(data[:liked_average] - data[:disliked_average])
         end
         .first(2) %>

    <% if vibes.any? %>
      <h3>Possible atmosphere preferences</h3>

      <p>
        <%= vibes.map { |name, _| name.to_s.titleize }.join(" & ") %>
      </p>
    <% end %>

    <% if summary[:participants_voted] < summary[:group_size].to_i %>
      <small>
        Not everyone has voted yet.
        Preferences may change as more responses are received.
      </small>
    <% end %>

    <% if search_query.present? %>
      <h3>Search strategy</h3>
      <p><%= search_query %></p>
    <% end %>

    <small>
      These results are based on your preferences.
      Exact prices, seating capacity and dietary
      accommodation must be confirmed with each restaurant.
    </small>
  </div>
</section>
