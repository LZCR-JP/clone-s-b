<div class="container mt-4">
  <h1>Join <%= @nomikai.name %></h1>

  <p>Location: <%= @nomikai.area %></p>
  <p>Guests: <%= @nomikai.group_size %></p>
  <p>Suggested budget: ¥<%= @nomikai.budget_per_person %></p>

  <% @participant.errors.full_messages.each do |message| %>
    <p class="text-danger"><%= message %></p>
  <% end %>

  <%= simple_form_for @participant,
                url: join_path(@nomikai.share_token) do |f| %>

    <div class="mb-3">
      <%= f.label :nickname, "Your Name" %>
      <%= f.text_field :nickname,
                       class: "form-control",
                       required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :budget_max, "Maximum Budget (JPY)" %>
      <%= f.number_field :budget_max,
                         min: 1,
                         class: "form-control",
                         required: true %>
    </div>

    <div class="mb-3">
      <h5>Dietary Restrictions</h5>

      <% ["Vegetarian", "Vegan", "Halal", "Gluten-free",
          "Seafood allergy", "Nut allergy"].each do |restriction| %>

        <div class="form-check">
          <%= check_box_tag "participant[restrictions][]",
                            restriction,
                            @participant.restrictions.include?(restriction),
                            id: "restriction_#{restriction.parameterize}",
                            class: "form-check-input" %>

          <%= label_tag "restriction_#{restriction.parameterize}",
                        restriction,
                        class: "form-check-label" %>
        </div>

      <% end %>
    </div>

    <div class="form-check mb-3">
      <%= f.check_box :non_drinker, class: "form-check-input" %>
      <%= f.label :non_drinker, "I don't drink alcohol" %>
    </div>

    <%= f.submit "Continue", class: "btn btn-primary" %>

  <% end %>
</div>
