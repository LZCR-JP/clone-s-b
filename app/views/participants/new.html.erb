<div class="container py-5">
  <div class="participant-join">

    <!-- Branding -->
    <div class="join-brand">
      <h2>Swipe <span>&</span> Bite</h2>
      <p>GOOD FOOD. BETTER TOGETHER.</p>
    </div>

    <!-- Introduction -->
    <div class="join-header">
      <span class="join-label">YOU'RE INVITED</span>
      <h1>Join the event!</h1>
      <p>Tell us your preferences and help your team find the perfect restaurant.</p>
    </div>

    <!-- Event information -->
    <div class="join-event-card">
      <h2><%= @nomikai.name %></h2>

      <div class="join-event-details">
        <p>
          <i class="fa-solid fa-location-dot"></i>
          <%= @nomikai.area %>
        </p>

        <p>
          <i class="fa-solid fa-calendar"></i>
          <%= @nomikai.event_date.strftime("%b %d, %Y · %H:%M") %>
        </p>

        <p>
          <i class="fa-solid fa-users"></i>
          <%= @nomikai.group_size %> people
        </p>

        <p>
          <i class="fa-solid fa-wallet"></i>
          ¥<%= number_with_delimiter(@nomikai.budget_per_person) %> suggested budget
        </p>
      </div>
    </div>

    <!-- Participant form -->
    <div class="join-form-card">
      <h2>Tell us about yourself</h2>
      <p class="form-description">
        Your preferences will help us find restaurants everyone can enjoy.
      </p>

      <%= simple_form_for @participant,
          url: join_path(@nomikai.share_token) do |f| %>

        <%= f.error_notification %>

        <%= f.input :nickname,
                    label: "Your name",
                    placeholder: "Enter your name",
                    required: true %>

        <%= f.input :budget_max,
                    label: "Maximum budget (JPY)",
                    placeholder: "e.g. 5000",
                    as: :numeric,
                    input_html: { min: 1 },
                    required: true %>

        <div class="dietary-section">
          <h3>Dietary restrictions</h3>
          <p>Select all that apply.</p>

          <%= f.input :restrictions,
                      as: :check_boxes,
                      collection: [
                        "Vegetarian",
                        "Vegan",
                        "Halal",
                        "Gluten-free",
                        "Seafood allergy",
                        "Nut allergy"
                      ],
                      label: false,
                      include_hidden: false %>
        </div>

        <%= f.input :non_drinker,
                    as: :boolean,
                    label: "I don't drink alcohol" %>

        <%= f.button :submit,
                     "Join the Event",
                     class: "btn-join-event" %>

      <% end %>
    </div>

    <p class="join-footer">
      Made for better team dining experiences.
    </p>

  </div>
</div>
