
<div class="container py-5">
  <div class="participant-dashboard">

    <!-- Welcome header -->
    <div class="participant-welcome">
      <span class="welcome-label">SWIPE & BITE</span>
      <h1>You're in, <%= @participant.nickname.capitalize %>!</h1>
      <p>Your team dinner journey starts here. Let's find somewhere delicious.</p>
    </div>

    <!-- Event card -->
    <div class="participant-event-card">
      <div class="event-card-header">
        <div>
          <span class="section-label">YOUR EVENT</span>
          <h2><%= @nomikai.name.capitalize %></h2>
        </div>

        <span class="event-status <%= @nomikai.status %>">
          <%= @nomikai.status.capitalize %>
        </span>
      </div>

      <div class="event-info-grid">
        <div class="event-info-item">
          <i class="fa-solid fa-location-dot"></i>
          <div>
            <span>Location</span>
            <strong><%= @nomikai.area %></strong>
          </div>
        </div>

        <div class="event-info-item">
          <i class="fa-solid fa-calendar"></i>
          <div>
            <span>Date & Time</span>
            <strong><%= @nomikai.event_date.strftime("%b %d, %Y · %H:%M") %></strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Personal preferences -->
    <div class="participant-preferences">
      <div class="preferences-heading">
        <h2>Your dining preferences</h2>
        <p>Here's what we'll consider when finding restaurants for you.</p>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <div class="preference-content">
          <span>Maximum budget</span>
          <strong>¥<%= number_with_delimiter(@participant.budget_max) %></strong>
        </div>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <div class="preference-content">
          <span>Dietary restrictions</span>
          <strong>
            <%= @participant.restrictions.present? ? @participant.restrictions.join(", ") : "None" %>
          </strong>
        </div>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-wine-glass"></i>
        </div>
        <div class="preference-content">
          <span>Alcohol preference</span>
          <strong><%= @participant.non_drinker ? "Non-drinker" : "No preference" %></strong>
        </div>
      </div>
    </div>

    <!-- Next step -->
    <div class="participant-next-step">
      <% if @nomikai.status == "open" %>
        <div>
          <h2>Ready to find your next favorite spot?</h2>
          <p>Swipe through restaurants and help your team decide where to eat.</p>
        </div>

        <%= link_to participant_swipes_path(@participant.token),
                    class: "btn-start-swiping" do %>
          Start Swiping
          <i class="fa-solid fa-arrow-right"></i>
        <% end %>

      <% else %>
        <div class="closed-event-message">
          <h2>This event is closed</h2>
          <p>Restaurant swiping is no longer available for this event.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
